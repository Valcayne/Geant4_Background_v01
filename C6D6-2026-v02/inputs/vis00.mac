
#/vis/open OGL 600x600-0+0
/vis/open 
/vis/verbose errors
/vis/viewer/set/style surface
/vis/drawVolume
/vis/viewer/set/background white


#/vis/viewer/set/upVector 1 0 0
/vis/viewer/set/upVector 0 -1 0
/vis/viewer/set/viewpointThetaPhi 165 30
#/vis/viewer/set/viewpointThetaPhi 90  0 
#/vis/viewer/set/viewpointThetaPhi 90 90 
/vis/viewer/set/lightsVector 0.2 0.5 -0.3
#/vis/scene/add/axes
/vis/viewer/set/targetPoint 0 0 0 mm
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/viewpointThetaPhi 180 0


/vis/scene/add/trajectories
/vis/scene/endOfEventAction accumulate
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set neutron blue

