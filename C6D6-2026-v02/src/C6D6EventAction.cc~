C6D6EventAction::~C6D6EventAction() {
  
  for(G4int i=0;i<NDet;i++){
    delete [] SigEdep[i];
    delete [] SigTimeMin[i];
    delete [] SigTimeMax[i];
  }

  double CompTime=difftime(time(NULL),starttime)/3600.; // s --> hours
  G4cout<<" ######## Job with input "<<InputFname<<" with "<<NEventsToRun<<" run histories terminated after "<<CompTime<<" h , TotalNSignals = "<<TotalNSignals<<" ########"<<G4endl;
    
}

