void C6D6EventAction::EndOfEventAction(const G4Event* evt) {

  NEvents++;

  const auto primary_particle = evt->GetPrimaryVertex(0)->GetPrimary(0);
  G4double kineticEnergy = primary_particle->GetKineticEnergy();

  FromHitsToSignals(evt);

  G4AnalysisManager* theAnalysisManager = G4AnalysisManager::Instance();

  //Señales:
  //bool PrintAct=false;
  for(G4int i=0;i<NDet;i++){
    for(G4int j=0;j<SigNSignals[i];j++){
      if(SigEdep[i][j]>0){
	//if(SigTimeMin[i][j]/ns>15.e3 && SigTimeMin[i][j]/ns<50.e3 && SigEdep[i][j]>0.20*MeV){G4cout<<SigEdep[i][j]/MeV<<G4endl; PrintAct=true;}
	if(theInputManager->GetOutputInfo(0)>0){ //Histogramas unidimensionales
	  theAnalysisManager->FillH1(0,SigEdep[i][j]/MeV);
	  theAnalysisManager->FillH1(i+1,SigEdep[i][j]/MeV);
	  if(SigEdep[i][j]>0.15*MeV){
	    theAnalysisManager->FillH1(NDet+2,SigTimeMin[i][j]/ns);
	  }
	}
	if(theInputManager->GetOutputInfo(1)>0){ //Histogramas bidimensionales TOF-Edep histo
	  theAnalysisManager->FillH2(0,SigTimeMin[i][j]/ns,SigEdep[i][j]/MeV);
	  if(theInputManager->GetOutputInfo(1)==1){
	    theAnalysisManager->FillH2(i+1,SigTimeMin[i][j]/ns,SigEdep[i][j]/MeV);
	  }
	  if(theInputManager->GetOutputInfo(1)==3){ //TOF-Act
	    for (int k = 0; k < TotalNActProd; k++) {
	      theAnalysisManager->FillH2(1,SigTimeMin[i][j]/ns,ActProd[k]);
	    }
	  }
	}
	if(theInputManager->GetOutputInfo(2)>0){ //N-tupla
	  theAnalysisManager->FillNtupleDColumn(0, 0, NEvents);
	  theAnalysisManager->FillNtupleDColumn(0, 1, i+1);
	  theAnalysisManager->FillNtupleDColumn(0, 2, SigEdep[i][j]/MeV);
	  theAnalysisManager->FillNtupleDColumn(0, 3, SigTimeMin[i][j]/ns);
	  theAnalysisManager->AddNtupleRow(0);
	}
      }
    }
  }
  
  //No señales:
  if(theInputManager->GetOutputInfo(0)>0){ //Histogramas unidimensionales
    for (int i = 0; i < TotalNCaptures; i++) {
      theAnalysisManager->FillH1(NDet+1,TOFCaptures[i]/ns);
      theAnalysisManager->FillH1(NDet+4,kineticEnergy/eV);
    }
    for (int i = 0; i < TotalNActProd; i++) {
      theAnalysisManager->FillH1(NDet+3,ActProd[i]);
      //if(PrintAct){G4cout<<ActProd[i]<<G4endl;}
    }
    theAnalysisManager->FillH1(NDet+5,kineticEnergy/eV);
  }
  //if(PrintAct){G4cout<<" --------------------------- "<<G4endl; getchar();}

  
  //-------------------------------------------------------------
  //Pint progress:
  double CompTime=difftime(time(NULL),starttime)/60.; //minutes
  if(CompTime>NextPrint_minutes){
    PrintProgress();
    NextPrint_minutes*=2;
  }
  //-------------------------------------------------------------
  //Dump: (no funciona)
  /*
  if((NEvents%NDump)==0){
    G4cout<<"holi"<<G4endl;
    for(G4int i=0;i<=NDet;i++){
      if(theInputManager->GetOutputInfo(0)>0){
	tools::histo::h1d* h1=theAnalysisManager->GetH1(i);
	h1->set_bin_content(0,NEvents,NEvents,NEvents,0,0);
      }
      if(theInputManager->GetOutputInfo(1)>0){
	tools::histo::h2d* h2=theAnalysisManager->GetH2(i);
	h2->set_bin_content(0,0,NEvents,NEvents,NEvents,0,0,0,0);
      }
    }
    theAnalysisManager->Write();
  }
  */
  //-------------------------------------------------------------


}


void C6D6EventAction::PrintProgress(){

  double CompTime=difftime(time(NULL),starttime)/60.; //minutes

  G4cout<<" #### PROGRESS: "<<NEvents<<"/"<<NEventsToRun<<" run histories have been computed ("<<NEvents*100./NEventsToRun<<" %) in "<<CompTime<<" minutes ("<<CompTime/60.<<" h) (NSig="<<TotalNSignals<<")---> ("<<NEvents*60./CompTime<<" run histories/h, "<<TotalNSignals*60./CompTime<<" sig/h) ####"<<G4endl;
  G4cout<<" #### Estimated time left to complete the job ("<<theInputManager->GetInputFname()<<"): "<<CompTime*(NEventsToRun-NEvents)/(G4double)NEvents*1/60.<<" h --  Estimated time for the full job: "<<CompTime*NEventsToRun/(G4double)NEvents/60.<<" h ####"<<G4endl;
  
}

