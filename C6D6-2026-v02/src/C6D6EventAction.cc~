
#include "C6D6EventAction.hh"

C6D6EventAction::C6D6EventAction(C6D6PrimaryGeneratorAction* primaryGenerator)
    : NEvents(0), indexC6D6(-1), indexTarget(-1) {

  theInputManager=C6D6InputManager::getInstance();
  TotalNSignals=0;
  TotalNCaptures=0;
  TotalNActProd=0;
  
  // Primary Generator
  myPrimaryGenerator = primaryGenerator;

  // get number of events in file
  NEventsToRun = theInputManager->GetNEventsToRun();
  NDump = theInputManager->GetNDump();
  /// get number of detectors in file
  NDet = theInputManager->GetTotalNC6D6Detectors();
  NextPrint_minutes=1;

  SignalTimeWidth=20.*ns;
  for(G4int i=0;i<NDet;i++){
    SigEdep[i]=new G4double[MAXNSIG];
    SigTimeMin[i]=new G4double[MAXNSIG];
    SigTimeMax[i]=new G4double[MAXNSIG];
  }

  for(G4int i=1;i<=NDet;i++){
    theInputManager->GetEnergyResolutionPars(i,Eres_a1[i],Eres_a2[i]);
  }
  InputFname=theInputManager->GetInputFname();
  starttime=0;
}

