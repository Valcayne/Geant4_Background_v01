void C6D6EventAction::FromHitsToSignals(const G4Event* evt) {

  for(G4int i=0;i<NDet;i++){
    SigNSignals[i]=0;
  }
  
  G4SDManager* sdManager = G4SDManager::GetSDMpointer();
  if (indexC6D6 < 0)
    indexC6D6 = sdManager->GetCollectionID("C6D6SensitiveDetector");
  if (indexTarget < 0)
    indexTarget = sdManager->GetCollectionID("C6D6SensitiveTarget");

  G4HCofThisEvent* HCE = evt->GetHCofThisEvent();
  
  // Target info
  C6D6HitCollection* hitsTargetCollection = 0;
  TotalNCaptures=0;
  TotalNActProd=0;
  G4int PrevActProd=0;
  if (HCE) hitsTargetCollection = (C6D6HitCollection*)(HCE->GetHC(indexTarget));
  if (hitsTargetCollection) {
    G4int NHits = hitsTargetCollection->entries();
    for (int i = 0; i < NHits; i++) {
      C6D6Hit* hit=(*hitsTargetCollection)[i];
      if(hit->GetCopyNumber()<0){
	TOFCaptures[TotalNCaptures]=hit->GetTime()*ns;
	TotalNCaptures++;
      }
      else{
	if(hit->GetCopyNumber()!=PrevActProd){
	  ActProd[TotalNActProd]=hit->GetCopyNumber();
	  PrevActProd=ActProd[TotalNActProd];
	  TotalNActProd++;
	}
      }
    }
  }
  
  // Detectors info
  C6D6HitCollection* hitsC6D6Collection = 0;
  if (HCE) hitsC6D6Collection = (C6D6HitCollection*)(HCE->GetHC(indexC6D6));
  if (hitsC6D6Collection) {
    // Get info
    const G4int numberHits = hitsC6D6Collection->entries();
    for (int i = 0; i < numberHits; i++) {
      C6D6Hit* hit = (*hitsC6D6Collection)[i];
      G4int detectorN = hit->GetCopyNumber()-1;
      G4double TOF = hit->GetTime()*ns;
      G4double Edep = hit->GetEdep()*MeV;
      G4String parName = hit->GetParticleName();
      if(parName=="gamma" || parName=="e+" || parName=="e-"){
	//------------------------------------------
	//See if we add this Edep to some signal:
	G4bool AlreadyAdded=false;
	for(int i=0;i<SigNSignals[detectorN];i++){
	  if(TOF>=(SigTimeMin[detectorN][i]-SignalTimeWidth) && TOF<=(SigTimeMax[detectorN][i]+SignalTimeWidth)){
	    SigEdep[detectorN][i]+=Edep;
	    if(TOF<SigTimeMin[detectorN][i]){SigTimeMin[detectorN][i]=TOF;}
	    if(TOF>SigTimeMax[detectorN][i]){SigTimeMax[detectorN][i]=TOF;}
	    AlreadyAdded=true;
	    break;
	  }
	}
	//If not, new signal:
	if(!AlreadyAdded){//new signal
	  G4int i_sig=SigNSignals[detectorN];
	  SigNSignals[detectorN]++;
	  if(SigNSignals[detectorN]>MAXNSIG){
	    G4cout<<" ######## Error in "<<__FILE__<<", line "<<__LINE__<<" ########"<<G4endl; exit(1);
	  }
	  SigEdep[detectorN][i_sig]=Edep;
	  SigTimeMin[detectorN][i_sig]=TOF;
	  SigTimeMax[detectorN][i_sig]=TOF;
	}
	//------------------------------------------
      }
    }
  }

  //Energy resolution:
  for(G4int i=0;i<NDet;i++){
    TotalNSignals+=SigNSignals[i];
    if(Eres_a1[i+1]>0 && Eres_a2[i+1]>0){
      for(G4int j=0;j<SigNSignals[i];j++){
	G4double sigma=sqrt(Eres_a1[i+1]*SigEdep[i][j]+Eres_a2[i+1]*SigEdep[i][j]*SigEdep[i][j]);
	SigEdep[i][j]=G4RandGauss::shoot(SigEdep[i][j],sigma);
	if(SigEdep[i][j]<0){SigEdep[i][j]=0;}
      }
    }
  }
}

