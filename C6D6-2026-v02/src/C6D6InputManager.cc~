  G4cout<<" EAR-Target: "<<EARName<<" -  "<<TargetName<<G4endl;
  G4cout<<" TotalNC6D6Det: "<<TotalNC6D6Det<<G4endl;
  for(G4int i=1;i<=TotalNC6D6Det;i++){G4cout<<"   "<<flagC6D6[i]<<"  "<<zC6D6[i]<<"  "<<thetaC6D6[i]<<"  "<<phiC6D6[i]<<G4endl;}
  G4cout<<"-------------------------------------------------------------"<<G4endl;
